{
	"version": 2,
	"$schema": "https://schemas.wp.org/wp/6.5/theme.json",
	"settings": {
		"color": {
			"custom": false,
			"customGradient": false,
			"palette": [
				{
					"slug": "primary",
					"color": "#007cba",
					"name": "Primary Blue"
				},
				{
					"slug": "secondary",
					"color": "#e0e0e0",
					"name": "Light Gray"
				},
				
				
				{
					"slug": "dark",
					"color": "#000",
					"name": "Dark"
				},
				
				
				{
					"slug": "light-peach",
					"color": "#fff6f1",
					"name": "Light Peach"
				},
				{
					"slug": "light-pink",
					"color": "#efd8d2",
					"name": "Light Pink"
				},
				{
					"slug": "peach",
					"color": "#ffd2bf",
					"name": "Peach"
				},
				{
					"slug": "pink",
					"color": "#ec92ab",
					"name": "Pink"
				},
				{
					"slug": "saffron",
					"color": "#d59005",
					"name": "Saffron"
				},
				{
					"slug": "orange",
					"color": "#da3a03",
					"name": "Orange"
				}
				
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "Berkshire Swash, sans-serif",
					"name": "Berkshire Swash",
					"slug": "berkshire-swash"
				},
				{
					"fontFamily": "Ostrich Sans Rounded, sans-serif",
					"name": "Ostrich Sans Rounded",
					"slug": "ostrich-sans-rounded"
				},
				{
					"fontFamily": "Niconne, sans-serif",
					"name": "Niconne",
					"slug": "niconne"
				},
				{
                    "fontFamily": "\"Open Sans\", sans-serif",
                    "slug": "open-sans",
                    "name": "Open Sans"
                },
				{
					"fontFamily": "Helvetica, sans-serif",
					"name": "Helvetica",
					"slug": "helvetica"
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"size": "1em",
					"slug": "small"
				},
				{
					"name": "Default",
					"size": "1.5em",
					"slug": "default"
				},
				{
					"name": "Medium",
					"size": "2em",
					"slug": "medium"
				},
				{
					"name": "Large",
					"size": "3em",
					"slug": "large"
				},
				{
					"name": "Extra Large",
					"size": "4em",
					"slug": "extra-large"
				},
				{
					"name": "Huge",
					"size": "6em",
					"slug": "huge"
				}
			]
		},
		"layout": {
			"contentSize": "800px",
			"wideSize": "1200px"
		},
		"spacing": {
			"blockGap": "1em",
			"padding": true,
			"margin": true,
			"units": ["px", "em", "rem", "vh", "vw", "%"]
		},
		"blocks": {
			"core/button": {
				"color": {
					"palette": [
						{
							"slug": "button-background",
							"color": "#007cba",
							"name": "Button Background"
						},
						{
							"slug": "button-text",
							"color": "#ffffff",
							"name": "Button Text"
						}
					]
				},
				"typography": {
					"fontSize": "medium"
				}
			},
			"core/quote": {
		        "typography": {
		          "fontSize": "var(--wp--preset--font-size--large)",
		          "fontStyle": "italic"
		        },
		        "color": {
		          "text": "var(--wp--preset--color--primary)",
		          "background": "var(--wp--preset--color--light-peach)"
		        },
		        "border": {
		          "style": "solid",
		          "width": "2px",
		          "color": "var(--wp--preset--color--saffron)"
		        },
		        "spacing": {
		          "padding": {
		            "top": "var(--wp--custom--spacing--medium)",
		            "right": "var(--wp--custom--spacing--large)",
		            "bottom": "var(--wp--custom--spacing--medium)",
		            "left": "var(--wp--custom--spacing--large)"
		          }
		        }
			}
		}
	},
	"styles": {
		"color": {
			"text": "var(--wp--preset--color--dark)",
			"background": "var(--wp--preset--color--secondary)"
		},
		"spacing": {
			"blockGap": "1.2rem",
			"padding": {
				"left": "var:preset|spacing|40",
				"right": "var:preset|spacing|40"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--open-sans)",
			"fontSize": "var(--wp--preset--font-size--default)",
			"fontWeight": "400"
		},
		"elements": {
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--berkshire-swash)",
					"fontSize": "var(--wp--preset--font-size--huge)",
					"fontWeight": "400"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--berkshire-swash)",
					"fontSize": "var(--wp--preset--font-size--extra-large)",
					"fontWeight": "300"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--berkshire-swash)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "400"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ostrich-sans-rounded)",
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--open-sans)",
					"fontSize": "var(--wp--preset--font-size--default)"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--open-sans)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "400",
					"textTransform": "uppercase"
				}
			}
			
		},
		"blocks": {
			"core/heading": {
				"typography": {
					
				}
			},
			"core/image": {
                "variations": {
                    "rounded" : {
                        "border": {
                            "radius": "20px"
                        }
                    }
                }
            },
			"core/paragraph": {
				"spacing": {
					"margin": {
						"bottom": "1em"
					}
				}
			},
			"core/post-title": {
		        "color": {
		          "text": "var(--wp--preset--color--dark)"
		        },
		        "typography": {
		          "fontSize": "clamp(2rem, 5vw, 3rem)",
		          "fontFamily": "var(--wp--preset--font-family--open-sans)",
		          "letterspacing": "5px",
		          "lineHeight": "1.2",
		          "textDecoration": "none"
		        },
		        "spacing": {
		          "margin": {
		            "top": "var(--wp--preset--spacing--50)",
		            "bottom": "var(--wp--preset--spacing--30)"
		          }
		        }
		    },
			"core/spacer": {
                "default": "80px"
            }
		}
	}
}